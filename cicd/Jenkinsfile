pipeline {
    agent { node { label 'docker-build && amd64' } }

    stages {
        stage('Build') {
            steps {
                 sh '''#!/bin/bash
                 echo "Building.." 
                 '''                
            }
        }
        stage('Test') {
            steps {
                 sh '''#!/bin/bash
                 echo "Testing.." 
                 '''                
            }
        }
        stage('Deploy') {
            steps {
                 sh '''#!/bin/bash
                 echo "Deploying.." 
                 '''                
            }
        }
    }
}
